# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# EVERYTHING IS OPTIONAL. The application runs fully offline with no keys at
# all — Stage 2 and Stage 3 both default to local models via Ollama.

# ---------------------------------------------------------------- Stage 3
# Stage 3 picks its backend BY TRANSCRIPT SIZE. auto (default) | local | groq
#
#   auto  - Groq for short recordings (better quality), local beyond ~4,500
#           estimated tokens (~20 min of audio). Groq's free tier allows only
#           6,000 TOKENS PER MINUTE, so a 30-minute meeting (~6,800 tokens in
#           one call) cannot run there — and chunking can't rescue it, since
#           you'd have to wait a minute between chunks. Local has no such cap.
#   local - force local
#   groq  - force Groq regardless of size (fails on long transcripts)
#
# If the remote call fails for any reason, Stage 3 retries locally rather than
# returning an empty record.
# STAGE3_BACKEND=auto
# GROQ_API_KEY=gsk_your_key_here

# Groq model. NOTE: Groq rotates and deprecates model IDs — run
# `python checks/check_groq.py` to list what your account actually has.
# 'llama-3.3-70b-versatile' is widely documented online but was NOT available
# on our account; openai/gpt-oss-120b is the strongest one that was.
# STAGE3_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------- Stage 2
# Always local. Override to compare models, e.g. qwen3:14b
# STAGE2_MODEL=qwen3:8b

# ---------------------------------------------------------------- Ollama
# Context window. Ollama defaults LOW (often 2048-4096) regardless of what the
# model supports, which would SILENTLY TRUNCATE a long transcript — the model
# would summarise only the first few minutes and report it as complete.
# 16384 covers roughly a 60-minute meeting (~1.33 tokens per word, ~150-190
# spoken words per minute, plus prompt and output). Raise for longer, at a memory cost.
# OLLAMA_NUM_CTX=16384
# OLLAMA_URL=http://localhost:11434

# ---------------------------------------------------------------- Speakers
# Speaker diarization + evidence-based naming. Needs requirements-diarization.txt.
#   auto (default) - run if speechbrain is installed, otherwise skip with a note
#   on             - run (and warn loudly if it can't)
#   off            - never run
# DIARIZE=auto
