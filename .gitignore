# Secrets — NEVER commit. The submission is a public-ish artifact; a key in the
# repo is a real leak.
.env
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Scratch audio from the Stage 1 spikes — not part of the submission.
spikes/*.flac
spikes/*.wav

# NOTE: data/sample_meeting.wav is deliberately NOT ignored. The problem
# statement requires the shareable meeting recording to be submitted alongside
# the transcripts, minutes, decisions and action items generated from it, so the
# audio and its outputs must travel together.

# OS
.DS_Store
